{
    "swagger": "2.0",
    "info": {
        "description": "API backend pour la marketplace Odin.",
        "title": "Marketplace API",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:8080",
    "basePath": "/api/v1",
    "paths": {
        "/agents": {
            "get": {
                "description": "Récupère la liste de tous les agents enregistrés",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "agents"
                ],
                "summary": "Lister les agents",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/dto.AgentListResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/dto.ErrorResponse"
                        }
                    }
                }
            },
            "post": {
                "description": "Enregistre un nouvel agent sur la marketplace",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "agents"
                ],
                "summary": "Créer un agent",
                "parameters": [
                    {
                        "description": "Informations de l'agent",
                        "name": "agent",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/dto.CreateAgentRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/dto.SingleAgentResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/dto.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/dto.ErrorResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "dto.AgentListResponse": {
            "type": "object",
            "properties": {
                "data": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/model.Agent"
                    }
                }
            }
        },
        "dto.CreateAgentRequest": {
            "type": "object",
            "required": [
                "agent_type",
                "category",
                "creator_id",
                "name",
                "runtime"
            ],
            "properties": {
                "agent_type": {
                    "type": "string",
                    "maxLength": 255
                },
                "category": {
                    "type": "string",
                    "maxLength": 255
                },
                "creator_id": {
                    "type": "string"
                },
                "description": {
                    "type": "string"
                },
                "name": {
                    "type": "string",
                    "maxLength": 255,
                    "minLength": 3
                },
                "readme_markdown": {
                    "type": "string"
                },
                "runtime": {
                    "type": "string",
                    "maxLength": 255
                }
            }
        },
        "dto.ErrorResponse": {
            "type": "object",
            "properties": {
                "details": {
                    "type": "string",
                    "example": "Le champ name est obligatoire"
                },
                "error": {
                    "type": "string",
                    "example": "Données invalides"
                }
            }
        },
        "dto.SingleAgentResponse": {
            "type": "object",
            "properties": {
                "data": {
                    "$ref": "#/definitions/model.Agent"
                }
            }
        },
        "model.Agent": {
            "type": "object",
            "properties": {
                "agent_type": {
                    "type": "string"
                },
                "category": {
                    "type": "string"
                },
                "created_at": {
                    "type": "string"
                },
                "creator_id": {
                    "type": "string"
                },
                "description": {
                    "type": "string"
                },
                "downloads_count": {
                    "type": "integer"
                },
                "id": {
                    "type": "string"
                },
                "is_official_pick": {
                    "type": "boolean"
                },
                "name": {
                    "type": "string"
                },
                "readme_markdown": {
                    "type": "string"
                },
                "runtime": {
                    "type": "string"
                },
                "updated_at": {
                    "type": "string"
                }
            }
        }
    }
}